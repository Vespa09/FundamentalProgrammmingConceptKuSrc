<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="&#3650;&#3611;&#3619;&#3648;&#3592;&#3585;&#3605;&#3660;fund prog"/>
        <attribute name="authors" value="vespa"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-08 12:54:17 PM"/>
